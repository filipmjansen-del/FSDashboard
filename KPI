from __future__ import annotations

import pandas as pd


def calculate_ratio_kpi(raw: pd.DataFrame, definition: dict) -> pd.DataFrame:
    """Calculate a ratio KPI only when every required input exists.

    Missing source attributes are never interpreted as zero. A zero denominator
    returns a missing KPI value.
    """
    numerator_attrs = definition["numerator"]
    denominator_attrs = definition["denominator"]
    required = numerator_attrs + denominator_attrs

    df = raw.loc[
        (raw["Branche"] == definition["industry"]) & raw["Attribute"].isin(required),
        ["Branche", "ÅR", "regnr", "navn", "Attribute", "Value"],
    ].copy()

    wide = (
        df.pivot_table(
            index=["Branche", "ÅR", "regnr", "navn"],
            columns="Attribute",
            values="Value",
            aggfunc="first",
        )
        .reset_index()
    )

    for attr in required:
        if attr not in wide.columns:
            wide[attr] = pd.NA

    complete_mask = wide[required].notna().all(axis=1)
    numerator = wide[numerator_attrs].sum(axis=1, min_count=len(numerator_attrs))
    denominator = wide[denominator_attrs].sum(axis=1, min_count=len(denominator_attrs))

    kpi_value = numerator / denominator
    kpi_value = kpi_value.where(complete_mask & denominator.ne(0))

    result = wide[["Branche", "ÅR", "regnr", "navn"]].copy()
    result["KPI"] = definition["name"]
    result["KPI_Value"] = kpi_value
    result["CompleteInputs"] = complete_mask
    result["Numerator"] = numerator.where(complete_mask)
    result["Denominator"] = denominator.where(complete_mask)

    return result.sort_values(["ÅR", "navn"]).reset_index(drop=True)

