"""Industry-specific KPI modules."""

from __future__ import annotations

import importlib
import pkgutil
from collections import OrderedDict

INDUSTRY_PACKAGES = OrderedDict(
    [
        ("Bank", "kpis.bank"),
        ("Realkredit", "kpis.realkredit"),
        ("Forsikring", "kpis.forsikring"),
        ("Pension", "kpis.pension"),
        ("Tværgående pensionskasser", "kpis.tvaergaaende_pensionskasser"),
    ]
)


def _discover_kpis():
    registry = {}
    catalog = {industry: [] for industry in INDUSTRY_PACKAGES}

    for industry, package_name in INDUSTRY_PACKAGES.items():
        package = importlib.import_module(package_name)

        for module_info in pkgutil.iter_modules(package.__path__):
            if module_info.name.startswith("_"):
                continue

            module = importlib.import_module(f"{package_name}.{module_info.name}")
            if not hasattr(module, "KPI") or not hasattr(module, "calculate"):
                continue

            definition = dict(module.KPI)
            name = definition.get("name")
            module_industry = definition.get("industry")

            if not name:
                raise ValueError(f"{module.__name__} is missing KPI['name']")
            if module_industry != industry:
                raise ValueError(
                    f"{module.__name__} declares industry '{module_industry}' "
                    f"but is stored under '{industry}'."
                )
            if name in registry:
                raise ValueError(f"Duplicate KPI name: {name}")

            definition["calculate"] = module.calculate
            registry[name] = definition
            catalog[industry].append(name)

    for names in catalog.values():
        names.sort()

    return registry, catalog


KPI_REGISTRY, INDUSTRY_KPI_CATALOG = _discover_kpis()


def calculate_kpi(raw, kpi_name: str):
    if kpi_name not in KPI_REGISTRY:
        raise KeyError(f"Unknown KPI: {kpi_name}")
    return KPI_REGISTRY[kpi_name]["calculate"](raw)

